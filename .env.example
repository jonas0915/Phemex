# ══════════════════════════════════════════════════════════════════
#  Phemex Scalp Bot — configuration
#  Copy this file to .env and fill in your values.
#  The bot will refuse to start if required fields are missing or
#  if any configuration combination is invalid.
# ══════════════════════════════════════════════════════════════════

# ── Phemex API credentials ────────────────────────────────────────
# Obtain from: https://phemex.com/user-setting/api
# Required permissions: Read + Trade (Withdraw is NOT needed)
PHEMEX_API_KEY=your_api_key_here
PHEMEX_API_SECRET=your_api_secret_here

# Always test on Testnet first!  https://testnet.phemex.com
# Set to false only when you are confident the bot works correctly.
PHEMEX_TESTNET=true

# ── Market ────────────────────────────────────────────────────────
TRADING_SYMBOL=BTC/USDT:USDT       # perpetual futures pair
TRADING_TIMEFRAME=1m                # candle interval: 1m 3m 5m 15m 30m 1h
LEVERAGE=10                         # 1–100 — start conservatively; increase only after live testing

# ── Position Sizing — choose ONE mode ─────────────────────────────

# Mode A — Fixed USDT per trade (simple, predictable)
# Notional = TRADE_SIZE_USDT × LEVERAGE
TRADE_SIZE_USDT=100

# Mode B — Compound sizing (grows with your balance)
# Notional = current_balance × RISK_PER_TRADE_PCT/100 × LEVERAGE
# Set to 0 to disable and use TRADE_SIZE_USDT instead.
# ⚠  At 20% + 25x each trade exposes 5× your account. Start at 1–3%.
RISK_PER_TRADE_PCT=0

# ── Strategy parameters ───────────────────────────────────────────
EMA_FAST=9                          # fast EMA period  (must be < EMA_SLOW)
EMA_SLOW=21                         # slow EMA period
RSI_PERIOD=14                       # RSI lookback

RSI_OVERSOLD=30                     # RSI below this = oversold (LONG filter)
RSI_OVERBOUGHT=70                   # RSI above this = overbought (SHORT filter)

# Neutral zone: only enter LONG when RSI < RSI_LONG_MAX (avoids entries
# at extended momentum), only enter SHORT when RSI > RSI_SHORT_MIN.
RSI_LONG_MAX=60
RSI_SHORT_MIN=40

# ── Risk management ───────────────────────────────────────────────
MAX_SESSION_LOSS_PCT=30             # hard-stop: halt bot if session loss hits this %
TAKE_PROFIT_PCT=0.6                 # take-profit % per trade  (must be > STOP_LOSS_PCT)
STOP_LOSS_PCT=0.35                  # stop-loss % per trade
TRADE_COOLDOWN_SECONDS=30           # minimum seconds between trades

# ── Exchange-native SL / TP orders ────────────────────────────────
# When true, the bot places a stop-loss order and a take-profit limit
# order on the exchange immediately after every entry.  This means the
# position is protected even if the bot process crashes or loses
# network connectivity.  Strongly recommended for live trading.
# Set to false only for paper-trading / testnet debugging.
USE_EXCHANGE_SL_TP=true

# ── Order book / L2 signal filters ────────────────────────────────
# OB_DEPTH: how many price levels to fetch per side (20 is plenty)
OB_DEPTH=20

# OB_IMBALANCE_THRESHOLD: minimum bid/ask imbalance needed to confirm a signal.
# imbalance = (bid_vol − ask_vol) / (bid_vol + ask_vol) ∈ [−1, +1]
# LONG requires imbalance ≥ +threshold (buy pressure); SHORT ≤ −threshold.
# 0.10 = bids must exceed asks by at least 10% of near-market depth.
# Lower → more signals (noisier). Higher → fewer but higher-quality signals.
OB_IMBALANCE_THRESHOLD=0.10

# MAX_SPREAD_PCT: skip entry when bid-ask spread exceeds this % of mid-price.
# BTC perp spread is typically 0.002–0.010%; 0.05% is a safe ceiling.
MAX_SPREAD_PCT=0.05

# USE_VWAP_FILTER: only enter LONG when price ≥ VWAP, SHORT when price ≤ VWAP.
# Prevents counter-trend scalps against the dominant volume-weighted direction.
# Recommended for live trading once you've confirmed the strategy works on testnet.
USE_VWAP_FILTER=false

# ── Smart order execution (maker vs taker) ─────────────────────────
# Phemex maker rebate: −0.025%  |  taker fee: +0.075%
# Saving 0.10% per fill is meaningful against a 0.6% TP target.
#
# USE_MAKER_ENTRY=true → bot posts a limit inside the spread first.
# If not filled within MAKER_ENTRY_TIMEOUT_S it cancels and uses market.
USE_MAKER_ENTRY=true
MAKER_ENTRY_TIMEOUT_S=10            # 10s is safe for 1m candles; raise for slower TFs

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/trading_bot.log       # rotated at 5 MB, 5 backups kept
