# Phemex API Credentials
# Get these from: https://phemex.com/user-setting/api
PHEMEX_API_KEY=your_api_key_here
PHEMEX_API_SECRET=your_api_secret_here

# Set to true to use Phemex testnet (recommended for testing first)
PHEMEX_TESTNET=true

# Trading Configuration
TRADING_SYMBOL=BTC/USDT:USDT       # Futures pair to trade
TRADING_TIMEFRAME=1m                # Candle timeframe (1m, 3m, 5m)
LEVERAGE=25                         # Futures leverage (1-100). Risk-on: 20-25

# ── Position Sizing: pick ONE mode ────────────────────────────────────────
# Mode A — Fixed USDT per trade (simple)
TRADE_SIZE_USDT=200                 # Notional = TRADE_SIZE_USDT × LEVERAGE

# Mode B — Compound sizing (recommended for aggressive growth)
# Risks RISK_PER_TRADE_PCT% of current balance per trade, compounding with wins.
# Notional = balance × RISK_PER_TRADE_PCT/100 × LEVERAGE
# Set RISK_PER_TRADE_PCT=0 to disable and use TRADE_SIZE_USDT instead.
RISK_PER_TRADE_PCT=20               # 20% of balance × 25x = 5× account per trade

# Scalp Strategy Parameters
EMA_FAST=9                          # Fast EMA period
EMA_SLOW=21                         # Slow EMA period
RSI_PERIOD=14                       # RSI period
RSI_OVERBOUGHT=70                   # RSI overbought threshold
RSI_OVERSOLD=30                     # RSI oversold threshold

# Risk Management
MAX_SESSION_LOSS_PCT=30             # Hard-stop: halt trading if session loss hits this %
TAKE_PROFIT_PCT=0.6                 # Take profit % per trade
STOP_LOSS_PCT=0.35                  # Stop loss % per trade
MAX_CONCURRENT_TRADES=1             # Max open positions at once
TRADE_COOLDOWN_SECONDS=30           # Seconds to wait between trades

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
